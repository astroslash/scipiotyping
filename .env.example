# Local mode (SQLite; the defaults also work without this file)
SECRET_KEY=replace-with-at-least-32-random-characters
SCIPIO_DATABASE=instance/scipiotyping.db
SCIPIO_HOST=127.0.0.1
SCIPIO_PORT=5000

